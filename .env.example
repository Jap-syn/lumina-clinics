APP_NAME="Lumina Booking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Bangkok
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres is required: the no-double-booking rule is a GiST exclusion
# constraint. See config/database.php for why.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lumina
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Nothing runs in the background on Lumina's hosting, so there is no queue
# worker and no scheduler. Holds expire lazily on the request path.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_STORE=file

# Phase one reception login. Replace before anything real goes near this.
LUMINA_STAFF_TOKEN=lumina-reception
